# Optional: OpenAI API key for live contract analysis
# If not provided, the app will use realistic stub data
OPENAI_API_KEY=sk-...

# Optional: Stripe secret key for checkout sessions
# If not provided, the app will redirect to the Payment Link
STRIPE_SECRET_KEY=sk_test_... or sk_live_...

# Base URL for success/cancel redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000
